lightning_logs/
events.out.tfevents.*

# ---------- IDE 与系统文件 ----------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
~$*
*.tmp
*.bak

# ---------- 环境与密钥 ----------
.env
.env.*
secrets.*
