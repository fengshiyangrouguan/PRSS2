@@ -228,6 +228,14 @@ class TGN(torch.nn.Module):
     if len(unique_nodes) > 0:
       unique_messages = self.message_function.compute_message(unique_messages)

+      # guard (vendored patch): on homogeneous graphs a node may appear on the
+      # source side of a LATER event and the destination side of an EARLIER
+      # event in one batch; the official assert rejects the earlier update.
+      # Clamp each node's update time to its current last_update so memory
+      # time stays monotonic (no-op when the stream is already ordered).
+      cur = self.memory.get_last_update(unique_nodes)
+      unique_timestamps = torch.maximum(unique_timestamps, cur)
+
     # Update the memory with the aggregated messages
     self.memory_updater.update_memory(unique_nodes, unique_messages,
                                       timestamps=unique_timestamps)
