        "depth": 1,
        "script": "import itertools\nimport time\n\ndef solve(**kwargs):\n    n = kwargs['n']\n    m = kwargs['m']\n    matrix = kwargs['matrix']\n    if n > 10:\n        return {'job_sequence': list(range(1, n + 1))}\n    start_time = time.time()\n    best_makespan = float('inf')\n    best_seq = None\n    for perm in itertools.permutations(range(n)):\n        if time.time() - start_time > 8.0:\n            break\n        C = [[0] * m for _ in range(n)]\n        for i in range(n):\n            for j in range(m):\n                if i == 0 and j == 0:\n                    C[i][j] = matrix[perm[i]][j]\n                elif i == 0:\n                    C[i][j] = C[i][j - 1] + matrix[perm[i]][j]\n                elif j == 0:\n                    C[i][j] = C[i - 1][j] + matrix[perm[i]][j]\n                else:\n                    C[i][j] = max(C[i - 1][j], C[i][j - 1]) + matrix[perm[i]][j]\n        ms = C[n - 1][m - 1]\n        if ms < best_makespan:\n            best_makespan = ms\n            best_seq = perm\n    if best_seq is None:\n        best_seq = tuple(range(n))\n    return {'job_sequence': [x + 1 for x in best_seq]}",
