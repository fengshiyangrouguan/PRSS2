        "task_id": "flow_shop_scheduling",
        "depth": 1,
        "script": "def solve(**kwargs):\n    n = kwargs['n']\n    m = kwargs['m']\n    matrix = kwargs['matrix']\n    if n == 0:\n        return {'job_sequence': []}\n    def compute_makespan(seq, matrix):\n        n = len(seq)\n        m = len(matrix[0])\n        C = [[0] * m for _ in range(n)]\n        for i in range(n):\n            job = seq[i]\n            for j in range(m):\n                if i == 0 and j == 0:\n                    C[i][j] = matrix[job][j]\n                elif i == 0:\n                    C[i][j] = C[i][j-1] + matrix[job][j]\n                elif j == 0:\n                    C[i][j] = C[i-1][j] + matrix[job][j]\n                else:\n                    C[i][j] = max(C[i-1][j], C[i][j-1]) + matrix[job][j]\n        return C[-1][-1]\n    if m == 2:\n        jobs = list(range(n))\n        p1 = [matrix[j][0] for j in jobs]\n        p2 = [matrix[j][1] for j in jobs]\n        group1 = [j for j in jobs if p1[j] < p2[j]]\n        group2 = [j for j in jobs if p1[j] > p2[j]]\n        group1.sort(key=lambda j: p1[j])\n        group2.sort(key=lambda j: p2[j])\n        sequence = group1 + group2\n        return {'job_sequence': [j+1 for j in sequence]}\n    else:\n        totals = [sum(row) for row in matrix]\n        jobs = list(range(n))\n        jobs.sort(key=lambda j: totals[j], reverse=True)\n        current = [jobs[0]]\n        for k in range(1, n):\n            best_makespan = float('inf')\n            best_pos = 0\n            for pos in range(len(current) + 1):\n                temp_seq = current[:pos] + [jobs[k]] + current[pos:]\n                ms = compute_makespan(temp_seq, matrix)\n                if ms < best_makespan:\n                    best_makespan = ms\n                    best_pos = pos\n            current = current[:best_pos] + [jobs[k]] + current[best_pos:]\n        return {'job_sequence': [j+1 for j in current]}",
